{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
  },
  "Jwt": {
    "SecretKey": "<Enter-Your-JWT-Secret-Key-Here>",
    "Issuer": "<Enter-Valid-Issuer-URL-Here>",
    "Audience": "<Enter-Valid-Audience-URL-Here>",
    "DurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7
  },
  "MailSettings": {
    "Email": "<Enter-Your-System-Email-Here>",
    "DisplayName": "<Enter-Sender-Display-Name-Here>",
    "Password": "<Enter-Your-Email-App-Password-Here>",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "AWS": {
    "Region": "<Enter-Your-AWS-Region-Code-Here>",
    "AccessKey": "<Enter-Your-AWS-Access-Key-Here>",
    "SecretKey": "<Enter-Your-AWS-Secret-Key-Here>"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}